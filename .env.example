# Explicit historical provider routes retained from the source checkout.
# Load this file in your shell; no dotenv auto-loading and no API keys in Git.
MANTA_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
OPENROUTER_MAX_TOKENS=4096
V1_LLM_TIMEOUT_S=180
# Optional persistent cost ledger; inherited prices must be checked before use.
# V1_BUDGET_DB=outputs/request-budget.sqlite
# V1_MAX_COST_USD=5
